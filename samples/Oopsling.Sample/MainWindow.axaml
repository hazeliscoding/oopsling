<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Oopsling.Sample.MainWindow"
        Title="Oopsling Sample"
        Width="440" Height="200"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="24" Spacing="16" VerticalAlignment="Center">
    <TextBlock TextWrapping="Wrap">Each button ends this app with an unhandled exception, and Oopsling writes a report.</TextBlock>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="CrashButton" Content="Crash" Click="Crash" />
      <Button x:Name="BackgroundCrashButton" Content="Crash on a background thread" Click="CrashOnBackgroundThread" />
    </StackPanel>
  </StackPanel>
</Window>
