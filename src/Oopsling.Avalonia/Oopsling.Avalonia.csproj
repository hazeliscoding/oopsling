<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The Avalonia window for Oopsling: shows the last crash report, and opens it as a filled-in GitHub issue in the user's browser.</Description>
    <!-- Hosts publish with NativeAOT: trim and AOT analyzers run here, and their warnings are errors. -->
    <IsAotCompatible>true</IsAotCompatible>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Oopsling.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The oldest 12.x, so the package never makes a host upgrade Avalonia. Tests and the sample run the newest. -->
    <PackageReference Include="Avalonia" VersionOverride="12.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Oopsling\Oopsling.csproj" />
  </ItemGroup>

</Project>
