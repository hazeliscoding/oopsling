<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Also makes trim and AOT warnings errors, in build analyzers and in the NativeAOT publish. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- IDE0005 (unused usings) only runs in build when docs are generated. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>

    <Version>1.1.0-dev</Version>
    <Authors>Hazel Granados</Authors>
    <Company>Oopsling</Company>
    <Product>Oopsling</Product>
    <Copyright>Copyright 2026 Hazel Granados</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/hazeliscoding/oopsling</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hazeliscoding/oopsling</RepositoryUrl>
    <PackageTags>crash-reporting;crash;github-issues;privacy;no-telemetry;avalonia</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Pack fails on an API change that would break a host built against 1.0.0. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)src/README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)docs/brand/icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
